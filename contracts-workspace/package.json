{
  "name": "unitpay-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "UnitPay on-chain contracts — Arc Testnet only.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:arcTestnet": "hardhat run scripts/deploy.js --network arcTestnet",
    "deploy:escrow:circle": "node scripts/deploy-circle.js UnitPayEscrow 0x3600000000000000000000000000000000000000",
    "deploy:packet:circle": "node scripts/deploy-circle.js UnitPayPacket 0x3600000000000000000000000000000000000000",
    "deploy:metadata:arcTestnet": "REDEPLOY_CONTRACT=UnitPayMetadataRegistry hardhat run scripts/redeploy-standalone.js --network arcTestnet"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "dotenv": "^17.4.2",
    "hardhat": "^2.28.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6"
  }
}
