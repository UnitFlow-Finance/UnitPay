# UnitPay contracts — Arc Testnet ONLY.
#
# Copy this file to .env and fill in your own funded Arc Testnet key.
# Never commit .env — it is already in .gitignore.
# Never put a mainnet private key here — this project has no mainnet
# network configured and never will (Arc mainnet does not publicly exist).

# A funded Arc Testnet account's private key, used only by
# scripts/deploy.js via the `arcTestnet` Hardhat network.
PRIVATE_KEY=
