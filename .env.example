# UnitPay — Testnet Demo Environment Variables
#
# TESTNET ONLY. Do not put mainnet/production Circle keys in this app.
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already in .gitignore.

# Circle Developer API key (Console -> Keys -> Create a key -> Standard Key).
# Used server-side only — never exposed to the browser.
CIRCLE_API_KEY=

# Circle Wallets App ID for your User-Controlled Wallets configuration
# (Console -> Wallets -> User Controlled -> Configurator).
# Safe to expose to the browser (hence NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CIRCLE_APP_ID=

# Optional: override the Circle API base URL. Defaults to the SDK's own
# default (https://api.circle.com), which serves both testnet and mainnet
# Wallets endpoints keyed off which API key you use — make sure your key is
# a TESTNET key.
# NEXT_PUBLIC_CIRCLE_BASE_URL=https://api.circle.com

# On-chain UnitPay metadata registry.
# Pods, P2P offers/trades, custom tokens, arbitrator rules, virtual cards,
# and collaborative payment-link pod metadata are stored through this Arc
# Testnet contract instead of server files.
UNITPAY_METADATA_REGISTRY_ADDRESS=0x100012Cd3BFBd6af56dAd2E0a874001f1De5038e

# Optional per-chain RPC overrides for on-chain reads/writes. If unset, the app
# falls back to the public RPC configured in lib/chains/config.ts.
# UNITPAY_RPC_URL_ARC_TESTNET=https://your-arc-testnet-rpc.example
# UNITPAY_RPC_URL_ETHEREUM_SEPOLIA=https://your-ethereum-sepolia-rpc.example
# UNITPAY_RPC_URL_AVALANCHE_FUJI=https://your-avalanche-fuji-rpc.example
# UNITPAY_RPC_URL_OPTIMISM_SEPOLIA=https://your-op-sepolia-rpc.example
# UNITPAY_RPC_URL_ARBITRUM_SEPOLIA=https://your-arbitrum-sepolia-rpc.example
# UNITPAY_RPC_URL_BASE_SEPOLIA=https://your-base-sepolia-rpc.example
# UNITPAY_RPC_URL_POLYGON_AMOY=https://your-polygon-amoy-rpc.example
# UNITPAY_RPC_URL_UNICHAIN_SEPOLIA=https://your-unichain-sepolia-rpc.example
# UNITPAY_RPC_URL_SONIC_TESTNET=https://your-sonic-testnet-rpc.example
# UNITPAY_RPC_URL_WORLD_CHAIN_SEPOLIA=https://your-world-chain-sepolia-rpc.example
# UNITPAY_RPC_URL_SEI_ATLANTIC=https://your-sei-atlantic-rpc.example
# UNITPAY_RPC_URL_HYPER_EVM_TESTNET=https://your-hyperevm-testnet-rpc.example
# UNITPAY_RPC_URL_SOLANA_DEVNET=https://your-solana-devnet-rpc.example

# Legacy metadata-registry RPC override. Prefer UNITPAY_RPC_URL_ARC_TESTNET.
# UNITPAY_METADATA_RPC_URL=https://your-arc-testnet-rpc.example
