# UnitPay — Testnet Demo Environment Variables
#
# TESTNET ONLY. Do not put mainnet/production Circle keys in this app.
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already in .gitignore.

# Circle Developer API key (Console -> Keys -> Create a key -> Standard Key).
# Used server-side only — never exposed to the browser.
CIRCLE_API_KEY=

# Circle Wallets App ID for your User-Controlled Wallets configuration
# (Console -> Wallets -> User Controlled -> Configurator).
# Safe to expose to the browser (hence NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CIRCLE_APP_ID=

# Optional: override the Circle API base URL. Defaults to the SDK's own
# default (https://api.circle.com), which serves both testnet and mainnet
# Wallets endpoints keyed off which API key you use — make sure your key is
# a TESTNET key.
# NEXT_PUBLIC_CIRCLE_BASE_URL=https://api.circle.com

# On-chain UnitPay metadata registry.
# Pods, P2P offers/trades, custom tokens, arbitrator rules, virtual cards,
# and collaborative payment-link pod metadata are stored through this Arc
# Testnet contract instead of server files.
UNITPAY_METADATA_REGISTRY_ADDRESS=0x100012Cd3BFBd6af56dAd2E0a874001f1De5038e
# Optional RPC override. Defaults to https://rpc.testnet.arc.network.
# UNITPAY_METADATA_RPC_URL=https://rpc.testnet.arc.network
